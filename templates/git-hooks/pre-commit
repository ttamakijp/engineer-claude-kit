#!/usr/bin/env bash
# pre-commit hook - leak detection
# Distributed by engineer-claude-kit (Group C). Overwrite-safe runtime artifact.
set -euo pipefail

fail=0

# 1. gitleaks staged scan (only if gitleaks is on PATH)
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --redact -v; then
        echo "[pre-commit] gitleaks detected potential secrets. Commit blocked." >&2
        fail=1
    fi
else
    echo "[pre-commit] gitleaks not found, skipping leak scan" >&2
fi

# 2. Minimal PII / credential regex check on staged ADDED lines (lines starting with '+').
# NOTE: strip the diff '+' marker before scanning. Without this, '+' is consumed
# as the local part of an email address and decorators such as @pytest.fixture
# are falsely flagged ('+@pytest.fixture' matches local='+' domain='pytest.fixture').
staged_added="$(git diff --cached --no-color --unified=0 | grep '^+' | grep -v '^+++' | sed 's/^+//' || true)"

if [ -n "$staged_added" ]; then
    # Email addresses.
    #
    # Filter by VALUE, not by path. Excluding .mailmap / CODEOWNERS / *.md would
    # also stop detecting a real address in those files, and docs are exactly
    # where one tends to get pasted. What actually caused the false positives was
    # placeholder addresses used as documentation examples, so the reserved
    # domains of RFC 2606 / RFC 6761 and no-reply senders are dropped first and
    # everything else still fails the commit.
    #
    # The surviving addresses are printed: the previous message named no address,
    # leaving the author to hunt through the diff for it.
    email_hits="$(printf '%s\n' "$staged_added" \
        | grep -Eio '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' \
        | grep -Eiv '@(example\.(com|org|net)|[a-z0-9.-]*\.(invalid|test|localhost)|localhost)$' \
        | grep -Eiv '^(noreply|no-reply)@|@noreply\.' \
        | sort -u || true)"
    if [ -n "$email_hits" ]; then
        echo "[pre-commit] possible email address in staged changes:" >&2
        printf '%s\n' "$email_hits" | sed 's/^/           /' >&2
        fail=1
    fi
    # Phone numbers (international / hyphenated, 10+ digits grouped)
    if printf '%s\n' "$staged_added" | grep -Eq '(\+?[0-9]{1,3}[-. ]?)?(\([0-9]{2,4}\)[-. ]?)?[0-9]{2,4}[-. ][0-9]{2,4}[-. ][0-9]{3,4}'; then
        echo "[pre-commit] possible phone number in staged changes." >&2
        fail=1
    fi
    # API-key-like tokens: AWS AKIA, Anthropic sk-ant-, OpenAI sk-
    if printf '%s\n' "$staged_added" | grep -Eq 'AKIA[0-9A-Z]{16}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}'; then
        echo "[pre-commit] possible API key in staged changes." >&2
        fail=1
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "[pre-commit] leak check FAILED. Use 'git commit --no-verify' only if you are certain." >&2
    exit 1
fi

exit 0